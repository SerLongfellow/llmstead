{
  "name": "llmstead",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gradcheck": "esbuild scripts/gradcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gradcheck.mjs --log-level=warning && node node_modules/.cache/gradcheck.mjs",
    "bench": "esbuild scripts/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/bench.mjs --log-level=warning && node node_modules/.cache/bench.mjs",
    "evals": "esbuild scripts/evals.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/evals.mjs --log-level=warning && node node_modules/.cache/evals.mjs",
    "export-gguf": "esbuild scripts/export-gguf.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/export-gguf.mjs --log-level=warning && node node_modules/.cache/export-gguf.mjs",
    "clip": "esbuild scripts/clip-explore.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/clip.mjs --log-level=warning && node node_modules/.cache/clip.mjs",
    "clip:gradcheck": "esbuild scripts/clip-gradcheck.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/clip-gradcheck.mjs --log-level=warning && node node_modules/.cache/clip-gradcheck.mjs"
  },
  "dependencies": {
    "chart.js": "^4.4.7",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
